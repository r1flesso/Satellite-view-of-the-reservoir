# # ============================================================
# # Данный Dockerfile НЕ предназначен для прямого использования
# # Т.е. нельзя просто его раскомментировать и запустить
# # Пользователь должен адаптировать пути к модели, данным и скриптам
# # под свою локальную структуру проекта, предварительно скопировав код в другой файл
# # ============================================================
#
#
# # ------------------------------------------------------------
# # Базовый образ Python
# # При необходимости можно изменить версию Python
# # ------------------------------------------------------------
# FROM python:3.13-slim
#
#
# # ------------------------------------------------------------
# # Рабочая директория внутри контейнера
# # Ее называете как хотите, но везде вместо project будет название вашей директории
# # ------------------------------------------------------------
# WORKDIR /project
#
#
# # ------------------------------------------------------------
# # Копируем артефакты обученной модели из MLflow
# # Замените путь на актуальный путь к вашим mlruns
# # Чтобы понять какой у вас путь, просто разузнайте
# # в каком experiment и run ваша модель
# # ------------------------------------------------------------
# COPY mlruns/189071046489646243/models/m-315084cfa2404a828ee7a1baeca35140/artifacts/ /project/model/
#
#
# # ------------------------------------------------------------
# # Копируем датасет, используемый для инференса/оценки
# # Если вы собираетесь использовать датасет, который лежит в папке data в моей директории,
# # то просто пропишите абсолютный путь до этой таблицы
# # ------------------------------------------------------------
# COPY clear_data.csv /project/
#
#
# # ------------------------------------------------------------
# # Копируем Python-скрипт, который:
# # - загружает модель
# # - выполняет предсказания
# # - выводит метрики
# #
# # Тут вы просто пишите название файла, который будет создавать докер образ
# # ------------------------------------------------------------
# COPY Python_file_for_docker.py /project/
#
#
# # ------------------------------------------------------------
# # Устанавливаем зависимости
# # requirements.txt берётся из артефактов MLflow или из моей директории
# # ------------------------------------------------------------
# COPY mlruns/189071046489646243/models/m-315084cfa2404a828ee7a1baeca35140/artifacts/requirements.txt /project/
# RUN pip install --no-cache-dir -r /project/requirements.txt
#
#
# # ------------------------------------------------------------
# # Команда, выполняемая при запуске контейнера
# # Тут вы опять же меняете название файла
# # ------------------------------------------------------------
# CMD ["python", "/project/Python_file_for_docker.py"]
